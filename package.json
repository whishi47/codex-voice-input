    "helper": "node tools/deepseek-billing-helper.js",
    "validate": "node tools/deepseek-billing-helper.js --validate --once"
  },
  "keywords": [
    "deepseek",
    "v4",
    "codex",
    "billing",
    "codex-plus-plus"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.21.0"
  }
}
